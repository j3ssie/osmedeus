{
  "name": "osmedeus-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:turbo": "next dev --turbopack",
    "dev:nologin": "NEXT_PUBLIC_DISABLE_LOGIN=true next dev",
    "dev:nologin:turbo": "NEXT_PUBLIC_DISABLE_LOGIN=true next dev --turbopack",
    "dev:mock": "NEXT_PUBLIC_USE_MOCK=true NEXT_PUBLIC_DISABLE_LOGIN=true next dev",
    "dev:mock:turbo": "NEXT_PUBLIC_USE_MOCK=true NEXT_PUBLIC_DISABLE_LOGIN=true next dev --turbopack",
    "dev:api": "BASE_API_URL=http://localhost:8002 next dev",
    "clean:build": "bun scripts/clean-build-artifacts.mjs",
    "build:base": "rm -rf build out && NEXT_EXPORT=true next build",
    "build": "bun run build:base && bun run clean:build",
    "build:static": "bun run build:base && bun run clean:build",
    "start": "next start",
    "start:nologin": "NEXT_PUBLIC_DISABLE_LOGIN=true next start",
    "lint": "eslint ."
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.8",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@xyflow/react": "^13.0.2",
    "ag-grid-community": "^36.3.0",
    "ag-grid-react": "^36.3.0",
    "axios": "^1.21.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dagre": "^0.8.5",
    "js-yaml": "^5.5.0",
    "lucide-react": "^1.77.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.2",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/dagre": "^0.7.54",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.15.0",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4.3.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "packageManager": "bun@1.3.11",
  "engines": {
    "bun": ">=1.3.0"
  }
}
